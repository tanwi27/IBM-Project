# Project Name
PROJECT_NAME="AI Resume Screener"

# API Version Path Prefix
API_V1_STR="/api/v1"

# Database Configuration
# Default to SQLite local database
DATABASE_URL="sqlite:///./resume_screener.db"
# PostgreSQL connection string if pgvector is available:
# DATABASE_URL="postgresql://username:password@localhost:5432/resume_screener"

# Primary LLM Provider: "openai" | "anthropic" | "gemini"
PRIMARY_LLM_PROVIDER="openai"

# API Keys (Set at least one to enable LLM scoring and AutoFix)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
VOYAGE_API_KEY=""

# Model Configurations
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_MODEL="claude-3-5-sonnet-20240620"
GEMINI_MODEL="gemini-1.5-flash"

# Embedding Provider for keyword matching: "local" | "openai" | "gemini" | "voyage"
# "local" will run SentenceTransformers (or fallback hash vectors) offline for free
EMBEDDING_PROVIDER="local"
